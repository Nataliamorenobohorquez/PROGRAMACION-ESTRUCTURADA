print()
print("=" * 45)
print(f"  {'RESULTADO / RESULT':^41}")
print("=" * 45)
print(f"  {'Original':<20} {cadena}")
print(f"  {'Mayusculas / Uppercase':<20} {cadena_mayusculas}")
print("=" * 45)
print()
print("Sin importar si escribes en MAYUSCULAS,")
print("minusculas o MeZcLaDo, el sistema")
print("siempre lo toma como MAYUSCULAS.")
