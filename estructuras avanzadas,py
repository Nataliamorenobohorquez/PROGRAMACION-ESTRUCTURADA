# PARTE 1: PILA LIFO / LIFO STACK
# =============================================================================
# LIFO = Last In First Out = Ultimo en entrar, primero en salir
# Como una pila de platos: el ultimo que pones es el primero que tomas
# Like a stack of plates: the last one you put is the first one you take
# =============================================================================

print("\n" + "─" * 58)
print("  PARTE 1: PILA LIFO / LIFO STACK")
print("─" * 58)

class Pila:
    """
    Estructura LIFO implementada con lista de Python.
    LIFO structure implemented with Python list.
    """
    def __init__(self):
        self._datos = []   # lista interna / internal list

    def push(self, elemento):
        """Agrega al tope / Pushes to top."""
        self._datos.append(elemento)
        print(f"  push('{elemento}') → Tope / Top: '{self._datos[-1]}'")

    def pop(self):
        """Saca del tope (LIFO) / Pops from top (LIFO)."""
        if not self._datos:
            print("  pop() → Pila vacia / Empty stack")
            return None
        elemento = self._datos.pop()
        tope = self._datos[-1] if self._datos else "vacía / empty"
        print(f"  pop() → Salio / Left: '{elemento}' | Nuevo tope / New top: '{tope}'")
        return elemento

    def peek(self):
        """Muestra tope sin sacar / Shows top without removing."""
        return self._datos[-1] if self._datos else None

    def esta_vacia(self):
        return len(self._datos) == 0

    def __str__(self):
        return f"  Pila / Stack: {self._datos} ← tope / top"


# demostrar pila con acciones del sistema
# demonstrate stack with system actions
pila_historial = Pila()
print("\n  Registrando acciones / Logging actions:")
pila_historial.push("Registrar_Auriculares")
pila_historial.push("Actualizar_Precio_Mouse")
pila_historial.push("Eliminar_Teclado")
print(pila_historial)

print("\n  Deshaciendo acciones (LIFO) / Undoing actions (LIFO):")
pila_historial.pop()  # se deshace la ultima / undo the last
pila_historial.pop()  # se deshace la penultima / undo the second to last
print(pila_historial)


