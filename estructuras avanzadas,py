# PARTE 4: ESTRUCTURA COMBINADA - DICCIONARIO DE PILAS (MATRIZ DE PILAS)
# =============================================================================
# Combina un Diccionario + Pilas LIFO.
# Cada usuario tiene su propia pila de historial de acciones.
# Combines a Dictionary + LIFO Stacks.
# Each user has their own stack of action history.
# =============================================================================

print("\n" + "─" * 58)
print("  PARTE 4: ESTRUCTURA COMBINADA")
print("  Diccionario de Pilas / Dictionary of Stacks")
print("─" * 58)

# Matriz de Pilas: cada clave del diccionario es una Pila LIFO
# Stack Matrix: each dictionary key is a LIFO Stack
historial_por_usuario = {
    "Admin":    ["Login", "Ver_Productos", "Actualizar_Precio"],  # Pila LIFO
    "Vendedor": ["Login", "Registrar_Venta", "Consultar_Stock"],  # Pila LIFO
    "Auditor":  ["Login", "Generar_Reporte"]                      # Pila LIFO
}

def ver_historial(usuario):
    """
    Muestra el historial de un usuario.
    Shows the history of a user.
    """
    if usuario in historial_por_usuario:
        print(f"  Historial de {usuario}: {historial_por_usuario[usuario]}")
    else:
        print(f"  Usuario no encontrado / User not found: {usuario}")

def registrar_accion(usuario, accion):
    """
    Registra una accion en la pila del usuario (push).
    Registers an action in the user's stack (push).
    """
    if usuario not in historial_por_usuario:
        historial_por_usuario[usuario] = []
    historial_por_usuario[usuario].append(accion)
    print(f"  push('{accion}') para / for {usuario}")

def deshacer_accion(usuario):
    """
    Deshace la ultima accion del usuario (pop LIFO).
    Undoes the last user action (pop LIFO).
    """
    if usuario in historial_por_usuario and historial_por_usuario[usuario]:
        accion = historial_por_usuario[usuario].pop()
        print(f"  pop() → Accion revertida / Action reverted: '{accion}' para / for {usuario}")
    else:
        print(f"  No hay acciones para deshacer / No actions to undo: {usuario}")


print("\n  Estado inicial / Initial state:")
for usuario in historial_por_usuario:
    ver_historial(usuario)

print("\n  Registrando nuevas acciones / Registering new actions:")
registrar_accion("Admin",    "Eliminar_Producto_Mouse")
registrar_accion("Vendedor", "Cerrar_Caja")

print("\n  Deshaciendo ultima accion (LIFO) / Undoing last action (LIFO):")
deshacer_accion("Admin")
deshacer_accion("Vendedor")

print("\n  Estado final / Final state:")
for usuario in historial_por_usuario:
    ver_historial(usuario)


