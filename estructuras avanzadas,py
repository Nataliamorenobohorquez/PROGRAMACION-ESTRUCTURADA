# PARTE 3: LISTA DOBLEMENTE ENLAZADA / DOUBLY LINKED LIST
# =============================================================================
# Cada nodo apunta al SIGUIENTE y al ANTERIOR.
# Permite navegar en ambas direcciones: adelante y atras.
# Each node points to NEXT and PREVIOUS.
# Allows navigation in both directions: forward and backward.
# =============================================================================

print("\n" + "─" * 58)
print("  PARTE 3: NODO DOBLE / DOUBLE NODE")
print("─" * 58)

class NodoDoble:
    """
    Nodo con dos punteros: siguiente y anterior.
    Node with two pointers: next and previous.
    Permite navegacion bidireccional / Allows bidirectional navigation.
    """
    def __init__(self, dato):
        self.dato      = dato    # informacion / information
        self.siguiente = None    # puntero hacia adelante / forward pointer
        self.anterior  = None    # puntero hacia atras / backward pointer


# crear nodos / create nodes
nodo1 = NodoDoble("Producto A")
nodo2 = NodoDoble("Producto B")
nodo3 = NodoDoble("Producto C")

# conectar hacia adelante (siguiente) / connect forward (next)
nodo1.siguiente = nodo2
nodo2.siguiente = nodo3
nodo3.siguiente = None

# conectar hacia atras (anterior) / connect backward (previous)
nodo1.anterior  = None    # el primero no tiene anterior / first has no previous
nodo2.anterior  = nodo1
nodo3.anterior  = nodo2

print("\n  Recorrido ADELANTE / FORWARD traversal:")
actual = nodo1
while actual is not None:
    sig = actual.siguiente.dato if actual.siguiente else "None"
    ant = actual.anterior.dato  if actual.anterior  else "None"
    print(f"  ← {ant} | [{actual.dato}] | {sig} →")
    actual = actual.siguiente

print("\n  Recorrido ATRAS / BACKWARD traversal:")
actual = nodo3
while actual is not None:
    print(f"  '{actual.dato}'")
    actual = actual.anterior


