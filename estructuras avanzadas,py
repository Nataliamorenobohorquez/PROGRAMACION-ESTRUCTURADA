# PARTE 2: COLA FIFO / FIFO QUEUE
# =============================================================================
# FIFO = First In First Out = Primero en entrar, primero en salir
# Como una fila de supermercado: el primero que llega es el primero atendido
# Like a supermarket line: the first to arrive is the first to be served
# =============================================================================

print("\n" + "─" * 58)
print("  PARTE 2: COLA FIFO / FIFO QUEUE")
print("─" * 58)

class Cola:
    """
    Estructura FIFO implementada con collections.deque.
    FIFO structure implemented with collections.deque.
    deque es mas eficiente que lista para quitar del inicio.
    deque is more efficient than list for removing from the start.
    """
    def __init__(self):
        self._datos = deque()  # deque importado de collections / imported from collections

    def enqueue(self, elemento):
        """Agrega al final de la cola / Adds to end of queue."""
        self._datos.append(elemento)
        print(f"  enqueue('{elemento}') → Cola / Queue: {list(self._datos)}")

    def dequeue(self):
        """Saca del inicio (FIFO) / Removes from start (FIFO)."""
        if not self._datos:
            print("  dequeue() → Cola vacia / Empty queue")
            return None
        elemento = self._datos.popleft()  # popleft saca el primero / removes first
        print(f"  dequeue() → Atendido / Served: '{elemento}' | Restante / Remaining: {list(self._datos)}")
        return elemento

    def esta_vacia(self):
        return len(self._datos) == 0

    def __str__(self):
        return f"  Cola / Queue: {list(self._datos)} → frente / front"


# demostrar cola con pedidos
# demonstrate queue with orders
cola_pedidos = Cola()
print("\n  Llegada de pedidos / Order arrivals:")
cola_pedidos.enqueue("Pedido_001_Auriculares")
cola_pedidos.enqueue("Pedido_002_Mouse")
cola_pedidos.enqueue("Pedido_003_Teclado")

print("\n  Procesando pedidos en orden / Processing orders in order (FIFO):")
cola_pedidos.dequeue()  # primero en llegar, primero en salir
cola_pedidos.dequeue()
print(cola_pedidos)


